# API / Cloudflare Worker
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CORS_ORIGIN=http://localhost:5173
APP_ENV=development
NEON_AUTH_BASE_URL=https://example.neonauth.sa-east-1.aws.neon.tech/database/auth
NEON_AUTH_JWKS_URL=https://example.neonauth.sa-east-1.aws.neon.tech/database/auth/.well-known/jwks.json
AI_PROVIDER=cloudflare
AI_MODEL=@cf/meta/llama-3.2-3b-instruct
# Optional paid OpenAI adapter; API billing is separate from ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=

# Web / Vite
VITE_NEON_AUTH_URL=https://example.neonauth.sa-east-1.aws.neon.tech/database/auth
VITE_API_URL=http://localhost:8787
